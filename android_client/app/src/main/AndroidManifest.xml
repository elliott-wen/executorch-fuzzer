<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:label="ET Fuzz Client"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.AppCompat.Light">

        <!-- QNN/HTP: the Hexagon fastRPC client is a vendor lib (libcdsprpc.so). Android 12+ blocks
             apps from dlopen-ing non-public vendor native libs unless declared here; without it the
             QNN HTP stub fails instantly with "Failed to create transport for device, error: 4000"
             (no fastRPC logs — it never reaches the DSP). required=false: absent on non-Qualcomm SoCs. -->
        <uses-native-library android:name="libcdsprpc.so" android:required="false" />

        <!-- Samsung Exynos ENN: the delegate dlopen()s the vendor runtime lib libenn_public_api_cpp.so
             (present on Exynos 2500/2600 phones, provided by the device — NOT bundled). Android 12+
             blocks apps from dlopen-ing non-public vendor libs unless declared here; without it the
             ENN backend fails to load its API library. required=false: absent on non-Exynos SoCs. -->
        <uses-native-library android:name="libenn_public_api_cpp.so" android:required="false" />

        <!-- MediaTek Neuron/APU: our bundled libneuronusdk_adapter.mtk.so dlopen()s the on-device APU
             driver stack (present on Dimensity 9300/9400 firmware, NOT bundled). Android 12+ needs each
             non-public vendor lib declared to permit dlopen. required=false: absent on non-MediaTek SoCs. -->
        <uses-native-library android:name="libcmdl_ndk.mtk.so" android:required="false" />
        <uses-native-library android:name="libnir_neon_driver_ndk.mtk.so" android:required="false" />
        <uses-native-library android:name="libarmnn_ndk.mtk.so" android:required="false" />
        <uses-native-library android:name="libapuwareapusys_v2.mtk.so" android:required="false" />
        <uses-native-library android:name="libapuwareutils_v2.mtk.so" android:required="false" />
        <uses-native-library android:name="libapuwarexrp_v2.mtk.so" android:required="false" />

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Each EXECUTOR runs in its OWN process (android:process) so a native ExecuTorch crash
             kills only that executor — the coordinator (main process) keeps its broker connection
             and respawns the executor. Executors hold no broker connection; the coordinator drives
             them over a bound Messenger. -->
        <service android:name=".Executor0" android:process=":e0" android:exported="false" />
        <service android:name=".Executor1" android:process=":e1" android:exported="false" />
        <service android:name=".Executor2" android:process=":e2" android:exported="false" />
        <service android:name=".Executor3" android:process=":e3" android:exported="false" />
        <service android:name=".Executor4" android:process=":e4" android:exported="false" />
        <service android:name=".Executor5" android:process=":e5" android:exported="false" />
        <service android:name=".Executor6" android:process=":e6" android:exported="false" />
        <service android:name=".Executor7" android:process=":e7" android:exported="false" />
        <service android:name=".Executor8" android:process=":e8" android:exported="false" />
        <service android:name=".Executor9" android:process=":e9" android:exported="false" />
        <service android:name=".Executor10" android:process=":e10" android:exported="false" />
        <service android:name=".Executor11" android:process=":e11" android:exported="false" />
        <service android:name=".Executor12" android:process=":e12" android:exported="false" />
        <service android:name=".Executor13" android:process=":e13" android:exported="false" />
        <service android:name=".Executor14" android:process=":e14" android:exported="false" />
        <service android:name=".Executor15" android:process=":e15" android:exported="false" />
    </application>
</manifest>
