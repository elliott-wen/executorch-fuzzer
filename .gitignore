# Python bytecode caches
__pycache__/
*.py[cod]

# Local virtual environment (recreate from requirements.txt — see docs/environment-setup.md)
.venv/

# Generation output + scratch: corpus dirs, crash samples, logs, broker samples,
# skip-reason TSVs, measurement TSVs/logs. The fuzzer writes all transient data here.
tmp/
corpus*/

# ExecuTorch programs / serialized artifacts emitted during lowering
*.pte

# Android build artifacts (the AAR is built from source; rebuild rather than commit)
android/.gradle/
android/**/build/
android/app/libs/*.aar
android/local.properties
android/captures/
*.apk

# NOT ignored (tracked on purpose): approved_constraints/ (vendored constraint data),
# gen/backends/, run_pregen.sh, *.md docs, and all package source.
pytorch_ref/
android-dev
neuropilot_sdk/
samsung_sdk/
.venv-mtk/

# FVP bare-metal runner build cache (rebuilt on demand)
fvp_client/.runner-build/

# Samsung Exynos AI LiteCore SDK (gated download) + the ENN backend build cache.
# Install via gen/export/backends/setup_samsung_sdk.sh; rebuild rather than commit.
samsung_sdk/
.samsung_build/
